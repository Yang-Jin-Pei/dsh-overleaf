{
  "name": "dsh-plugin-overleaf",
  "version": "0.1.0",
  "private": true,
  "description": "Overleaf (self-hosted / CE) access for DeepSeek Harness: cookie login, project browser, file download/upload, compile",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
